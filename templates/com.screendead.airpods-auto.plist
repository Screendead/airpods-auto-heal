<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.screendead.airpods-auto</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Library/Application Support/airpods-auto-heal/airpods_auto_watch.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.cache/airpods-auto/agent.out</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.cache/airpods-auto/agent.err</string>
</dict>
</plist>
